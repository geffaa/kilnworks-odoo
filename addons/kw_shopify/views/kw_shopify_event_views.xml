<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kw_shopify_event_view_list" model="ir.ui.view">
        <field name="name">kw.shopify.event.list</field>
        <field name="model">kw.shopify.event</field>
        <field name="arch" type="xml">
            <list create="False" decoration-warning="state == 'needs_mapping'" decoration-danger="state == 'failed'">
                <field name="received_at"/>
                <field name="order_name"/>
                <field name="topic"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-warning="state == 'needs_mapping'" decoration-danger="state == 'failed'"
                       decoration-info="state == 'queued'"/>
                <field name="sale_order_id"/>
                <field name="error" optional="show"/>
                <field name="attempts" optional="hide"/>
                <field name="store_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="kw_shopify_event_view_form" model="ir.ui.view">
        <field name="name">kw.shopify.event.form</field>
        <field name="model">kw.shopify.event</field>
        <field name="arch" type="xml">
            <form create="False" edit="False">
                <header>
                    <button name="action_map_sku" type="object" string="Map SKU" class="btn-primary"
                            invisible="state != 'needs_mapping' or can_retry"/>
                    <button name="action_retry" type="object" string="Retry" invisible="not can_retry"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="order_name"/></h1></div>
                    <group>
                        <group>
                            <field name="topic"/>
                            <field name="store_id"/>
                            <field name="sale_order_id"/>
                            <field name="can_retry" invisible="1"/>
                        </group>
                        <group>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                            <field name="attempts"/>
                            <field name="duplicate_count"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not error">
                        <field name="error"/>
                    </div>
                    <notebook>
                        <page string="Payload"><field name="payload" readonly="1"/></page>
                        <page string="Technical">
                            <group><field name="webhook_id"/><field name="order_gid"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="kw_shopify_event_view_search" model="ir.ui.view">
        <field name="name">kw.shopify.event.search</field>
        <field name="model">kw.shopify.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_name"/>
                <field name="missing_skus"/>
                <filter name="attention" string="Needs a look" domain="[('state', 'in', ('needs_mapping', 'failed', 'queued'))]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_topic" string="Topic" context="{'group_by': 'topic'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="kw_shopify_event_action" model="ir.actions.act_window">
        <field name="name">Sync log</field>
        <field name="res_model">kw.shopify.event</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="kw_shopify_console_action" model="ir.actions.client">
        <field name="name">Shopify</field>
        <field name="tag">kw_shopify.console</field>
    </record>
</odoo>
