<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">kw_ops_dashboard.dashboard</field>
    </record>
    <menuitem id="menu_dashboard" name="Dashboard" parent="kw_ops.menu_root" sequence="5" action="action_dashboard"/>
    <!-- Opening the app lands on the dashboard. -->
    <record id="kw_ops.menu_root" model="ir.ui.menu">
        <field name="action" ref="action_dashboard"/>
    </record>
</odoo>
