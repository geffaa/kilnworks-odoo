<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kw_ops" model="ir.module.category">
        <field name="name">Kilnworks Ops</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_kw_ops"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_production_lead" model="res.groups">
        <field name="name">Production lead (approver tier 1)</field>
        <field name="category_id" ref="module_category_kw_ops"/>
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Owner (approver tier 2, manages integrations)</field>
        <field name="category_id" ref="module_category_kw_ops"/>
        <field name="implied_ids" eval="[Command.link(ref('group_production_lead'))]"/>
    </record>
</odoo>
