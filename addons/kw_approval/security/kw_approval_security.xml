<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- People manage delegations they give; delegates can see the ones given to them. -->
    <record id="rule_delegation_own" model="ir.rule">
        <field name="name">Delegation: own</field>
        <field name="model_id" ref="model_kw_approval_delegation"/>
        <field name="domain_force">['|', ('delegator_id', '=', user.id), ('delegate_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('kw_ops.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_delegation_delegate_readonly" model="ir.rule">
        <field name="name">Delegation: delegates cannot change it</field>
        <field name="model_id" ref="model_kw_approval_delegation"/>
        <field name="domain_force">[('delegator_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('kw_ops.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_delegation_manager" model="ir.rule">
        <field name="name">Delegation: owner sees all</field>
        <field name="model_id" ref="model_kw_approval_delegation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('kw_ops.group_manager'))]"/>
    </record>
</odoo>
