<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Purchase: above Rp 10 M the production lead approves; above Rp 25 M the owner too.
         OCA numbers reviews from the HIGHEST definition sequence down, so the tier that must
         go first carries the larger sequence. -->
    <record id="tier_po_lead" model="tier.definition">
        <field name="name">Purchase above Rp 10 M: production lead</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="kw_ops.group_production_lead"/>
        <field name="definition_domain">[("kw_amount_company", "&gt;", 10000000)]</field>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
        <field name="notify_on_create" eval="True"/>
        <field name="kw_self_approval_group_id" ref="kw_ops.group_manager"/>
        <field name="kw_escalation_group_id" ref="kw_ops.group_manager"/>
    </record>
    <record id="tier_po_owner" model="tier.definition">
        <field name="name">Purchase above Rp 25 M: owner</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="kw_ops.group_manager"/>
        <field name="definition_domain">[("kw_amount_company", "&gt;", 25000000)]</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
        <field name="notify_on_create" eval="True"/>
        <field name="kw_escalation_group_id" ref="kw_ops.group_manager"/>
    </record>
    <!-- Sales: any line discount above 10 % needs the owner. -->
    <record id="tier_so_discount" model="tier.definition">
        <field name="name">Discount above 10 %: owner</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="kw_ops.group_manager"/>
        <field name="definition_domain">[("kw_max_discount", "&gt;", 10)]</field>
        <field name="sequence">10</field>
        <field name="notify_on_create" eval="True"/>
        <field name="kw_escalation_group_id" ref="kw_ops.group_manager"/>
    </record>
</odoo>
