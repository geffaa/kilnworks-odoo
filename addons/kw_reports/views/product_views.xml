<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_kw_export" model="ir.ui.view">
        <field name="name">product.template.form.kw.export</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <group string="Export" name="kw_export">
                    <field name="kw_hs_code" placeholder="6912.00"/>
                    <field name="kw_carton_qty"/>
                    <field name="kw_carton_tare_kg"/>
                    <field name="kw_carton_dims"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
